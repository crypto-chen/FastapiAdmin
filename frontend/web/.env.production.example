# 【生产】环境变量 - 覆盖通用配置（案例）
#
# 用法：复制为 .env.production（已被 .gitignore 忽略）后按实际部署修改，再执行 npm run build。
# 注意：vite build 默认 mode=production，只加载 .env 与 .env.production，**不会**加载 .env.development，
#       所以生产构建必须保证下面这些键齐全，否则会出现「登录页弹请求失败」「静态资源 404」等问题。

# 环境标识
VITE_APP_ENV = prod

# 项目名称（index.html 里的 %VITE_APP_TITLE% 占位符由它替换；缺失会原样保留在标题里）
VITE_APP_TITLE = FastapiAdmin

# 前端资源基础路径（决定 /js、/css 从哪取）
#   /      站点挂在域名/端口根路径（nginx root 直接指向 dist）
#   /web/  站点挂在子路径（nginx 需配 location /web { alias .../dist; }）
# 必须与 nginx 实际布局一致，否则静态资源 404、页面白屏
VITE_BASE_URL = /

# 接口前缀（axios baseURL）：缺失会导致请求少 /api/v1 前缀，
# 被 nginx 的 SPA 回退（location / try_files ... /index.html）接走并返回 HTML，前端报「请求失败」
VITE_APP_BASE_API = /api/v1

# 部分组件（富文本上传等）使用的接口前缀：后端真实路径是 /api/v1/common/file/upload
VITE_API_URL = /api/v1/common

# 是否删除控制台输出
VITE_DROP_CONSOLE = true

# WebSocket 端点（AI 对话 / 健康流）：必须是浏览器能访问到的地址
#   独立 IP:端口部署：ws://120.237.174.243:6479（走 nginx 的 /api/v1/ai/chat/ws 代理）
#   正式域名 + https：wss://your-production-domain.com
VITE_APP_WS_ENDPOINT = ws://your-server-ip:port

# 跨域请求是否携带 Cookie（与后端 CORS 配置配套）
VITE_WITH_CREDENTIALS = false

# 权限模式：frontend 仅前端路由 / backend 仅后端菜单 / mixed 后端菜单+前端路由合并
VITE_ACCESS_MODE = mixed

+async def _load_world_map() -> dict[str, str]:
+    """国家/地区字典（ID → 名称）；取不到时返回空、不影响其它字段。"""
+    import httpx
+
+    from app.modules.crm.client import DEFAULT_BASE_URL
+
+    try:
+        async with httpx.AsyncClient(timeout=30, follow_redirects=True) as client:
+            response = await client.get(f"{DEFAULT_BASE_URL}{WORLD_LIST_PATH}")
+            payload = response.json().get("data")
+        if isinstance(payload, dict):
+            return {str(key): str(value) for key, value in payload.items()}
+        if isinstance(payload, list):
+            return {
+                str(item.get("id")): str(item.get("name"))
+                for item in payload
+                if isinstance(item, dict) and item.get("id") is not None
+            }
+    except Exception as exc:  # noqa: BLE001 - 字典取不到只是少一层翻译
+        logger.warning(f"国家字典取数失败（{WORLD_LIST_PATH}）：{exc}")
+    return {}
+
+
+def map_region_names(value: str, world_map: dict[str, str]) -> str:
+    """地区取值里的纯数字（国家 ID）翻译成名称，其余原样保留。"""
+    if not value:
+        return value
+    return "/".join(
+        world_map.get(part, part) if part.isdigit() else part for part in value.split("/") if part
+    )
+
+
+def period_end_date(period_value: str) -> date:
+    """``YYYY-MM`` → 期间末日（账龄截止日）。"""
+    year, month = (int(part) for part in period_value.split("-")[:2])
+    leap = 29 if year % 4 == 0 and (year % 100 != 0 or year % 400 == 0) else 28
+    last_day = [31, leap, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][month - 1]
+    return date(year, month, last_day)
+
+
+def previous_period_value(period_value: str) -> str:
+    """``YYYY-MM`` → 上一期。"""
+    year, month = (int(part) for part in period_value.split("-")[:2])
+    year, month = (year - 1, 12) if month == 1 else (year, month - 1)
+    return f"{year}-{month:02d}"
+
+
+async def _load_previous_inventory(db: AsyncSession, period_value: str) -> dict[str, float]:
+    """上期（上一自然月，最新版本）各客户的理论库存，用于算平均库存（CUS-37）。"""
+    previous = previous_period_value(period_value)
+    version = (
+        await db.execute(
+            select(func.max(CustomerAnalysisModel.calc_version)).where(
+                CustomerAnalysisModel.period_value == previous
+            )
+        )
+    ).scalar()
+    if version is None:
+        return {}
+    rows = (
+        await db.execute(
+            select(CustomerAnalysisModel.customer_code, CustomerAnalysisModel.extra).where(
+                CustomerAnalysisModel.period_value == previous,
+                CustomerAnalysisModel.calc_version == version,
+                CustomerAnalysisModel.is_aggregate == 0,
+            )
+        )
+    ).all()
+    result: dict[str, float] = {}
+    for code, extra in rows:
+        if not code:
+            continue
+        result[str(code)] = to_number((extra or {}).get("CUS-36"))
+    return result
+

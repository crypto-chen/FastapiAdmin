+"""平台分析字段字典（PLT-xx）。
+
+与产品线分析的 PRD-xx 一样，字段说明由后端下发，前端按 ``field_code`` 渲染列。
+数据不落宽表，实时从 ``retail_order`` / ``retail_after_sale`` / ``retail_shop`` 汇总。
+"""
+
+from typing import Any
+
+PLATFORM_FIELDS: list[dict[str, Any]] = [
+    {
+        "field_code": "PLT-00",
+        "field_name": "期间",
+        "data_type": "string",
+        "group": "维度",
+        "sensitive": False,
+        "source": "retail_order",
+        "note": "订单归属期间 YYYY-MM（as_date→created→modified→confirm_date 的第一个可用时间）",
+        "status": "ready",
+        "status_label": "现用可出",
+        "stored_in": "retail_order.period_value",
+    },
+    {
+        "field_code": "PLT-01",
+        "field_name": "平台",
+        "data_type": "string",
+        "group": "维度",
+        "sensitive": False,
+        "source": "retail_shop",
+        "note": "由 retail_shop.shop_site 归一：京东/天猫/拼多多/抖音/其他",
+        "status": "ready",
+        "status_label": "现用可出",
+        "stored_in": "retail_shop.shop_site",
+    },
+    {
+        "field_code": "PLT-02",
+        "field_name": "店铺",
+        "data_type": "string",
+        "group": "维度",
+        "sensitive": False,
+        "source": "retail_shop",
+        "note": "店铺名称，缺店铺主数据时回退订单上的 shop_name",
+        "status": "ready",
+        "status_label": "现用可出",
+        "stored_in": "retail_shop.shop_name",
+    },
+    {
+        "field_code": "PLT-03",
+        "field_name": "店铺编号",
+        "data_type": "number",
+        "group": "维度",
+        "sensitive": False,
+        "source": "retail_order",
+        "note": "聚水潭 shop_id",
+        "status": "ready",
+        "status_label": "现用可出",
+        "stored_in": "retail_order.shop_id",
+    },
+    {
+        "field_code": "PLT-04",
+        "field_name": "订单数",
+        "data_type": "number",
+        "group": "数量",
+        "sensitive": False,
+        "source": "retail_order",
+        "note": "期间内有效订单数（排除 Delete，含取消单）",
+        "status": "ready",
+        "status_label": "现用可出",
+        "stored_in": "retail_order",
+    },
+    {
+        "field_code": "PLT-05",
+        "field_name": "已发货单数",
+        "data_type": "number",
+        "group": "数量",
+        "sensitive": False,
+        "source": "retail_order",
+        "note": "订单状态命中 RETAIL_SHIPPED_STATUSES（默认 Sent）",
+        "status": "ready",
+        "status_label": "现用可出",
+        "stored_in": "retail_order.status",
+    },
+    {
+        "field_code": "PLT-06",
+        "field_name": "取消单数",
+        "data_type": "number",
+        "group": "数量",
+        "sensitive": False,
+        "source": "retail_order",
+        "note": "订单状态命中 RETAIL_CANCELLED_STATUSES（默认 Cancelled）",
+        "status": "ready",
+        "status_label": "现用可出",
+        "stored_in": "retail_order.status",
+    },
+    {
+        "field_code": "PLT-08",
+        "field_name": "接单未税",
+        "data_type": "number",
+        "group": "金额",
+        "sensitive": True,
+        "source": "retail_order",
+        "note": "Σ 买家实付 ÷ (1 + RETAIL_TAX_RATE/100)，默认 13%，含后续取消的单",
+        "status": "ready",
+        "status_label": "现用可出",
+        "stored_in": "retail_order.buyer_paid_amount",
+    },
+    {
+        "field_code": "PLT-09",
+        "field_name": "货物出货未税",
+        "data_type": "number",
+        "group": "金额",
+        "sensitive": True,
+        "source": "retail_order",
+        "note": "已发货订单金额 ÷ 1.13（订单已发货即算货物出货）",
+        "status": "ready",
+        "status_label": "现用可出",
+        "stored_in": "retail_order.buyer_paid_amount",
+    },
+    {
+        "field_code": "PLT-10",
+        "field_name": "取消未税",
+        "data_type": "number",
+        "group": "金额",
+        "sensitive": True,
+        "source": "retail_order",
+        "note": "取消单金额 ÷ 1.13，负数（已并入 PLT-11）",
+        "status": "ready",
+        "status_label": "现用可出",
+        "stored_in": "retail_order.buyer_paid_amount",
+    },
+    {
+        "field_code": "PLT-11",
+        "field_name": "退货退款",
+        "data_type": "number",
+        "group": "金额",
+        "sensitive": True,
+        "source": "retail_after_sale + retail_order",
+        "note": "-(取消单金额 + 发货后售后实退) ÷ 1.13，负数",
+        "status": "ready",
+        "status_label": "现用可出",
+        "stored_in": "retail_after_sale.actual_refund",
+    },
+    {
+        "field_code": "PLT-12",
+        "field_name": "对外出货净额",
+        "data_type": "number",
+        "group": "金额",
+        "sensitive": True,
+        "source": "计算",
+        "note": "PLT-09 + PLT-11（PLT-11 为负数）",
+        "status": "ready",
+        "status_label": "现用可出",
+        "stored_in": "计算字段",
+    },
+    {
+        "field_code": "PLT-13",
+        "field_name": "营销结算收入10%",
+        "data_type": "number",
+        "group": "金额",
+        "sensitive": True,
+        "source": "计算",
+        "note": "PLT-12 × 10%（RETAIL_SETTLEMENT_RATE 可配）",
+        "status": "ready",
+        "status_label": "现用可出",
+        "stored_in": "计算字段",
+    },
+    {
+        "field_code": "PLT-37",
+        "field_name": "退货率",
+        "data_type": "percent",
+        "group": "比率",
+        "sensitive": False,
+        "source": "计算",
+        "note": "|PLT-11| ÷ PLT-12，PLT-12 ≤ 0 时改用 PLT-09 作分母",
+        "status": "ready",
+        "status_label": "现用可出",
+        "stored_in": "计算字段",
+    },
+]
+
+
+def field_codes() -> list[str]:
+    return [item["field_code"] for item in PLATFORM_FIELDS]
diff --git a/backend/app/modules/platform/schema.py b/backend/app/modules/platform/schema.py
